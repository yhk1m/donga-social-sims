6/page/p054.jpg"}],"quiz":null},{"id":"environment","title":"환경 문제","pages":[54],"view":{"map":"p54-garbage","center":[-174.979,36.633],"bounds":[121.6,3.3,248.5,63.1]},"views":[{"id":"garbage","label":"태평양의 거대 쓰레기 섬","map":"p54-garbage","center":[-174.979,36.633],"bounds":[121.6,3.3,248.5,63.1]},{"id":"sealevel","label":"남태평양의 해수면 변화 예측","map":"p54-sealevel","center":[-141.399,-5.824],"bounds":[140,-28,212,28]}],"layers":[{"ref":"layer-p54-garbage","type":"area","legend":true,"group":"map","label":"태평양의 거대 쓰레기 섬","credit":"(education.nationalgeographic.org, 2023)"},{"ref":"layer-p54-currents","type":"pathFlow","legend":true,"group":"map","label":"태평양의 거대 쓰레기 섬"},{"ref":"layer-p54-sealevel","type":"area","legend":false,"group":"map","label":"남태평양의 해수면 변화 예측","credit":"(유엔 정부 간 기후 변화 협의회(IPCC), 2013)"}],"markers":[],"blocks":[{"id":"question","type":"text","role":"question","text":"오세아니아와 태평양 지역은 세계와 어떤 영향을 주고받을까?"},{"id":"goal","type":"text","role":"goal","title":"학습 목표","text":"자원 수출을 중심으로 오세아니아 지역과 세계 다른 지역과의 상호 연계성을 설명할 수 있다. 태평양 지역이 겪고 있는 환경 문제의 해결 방안을 제안할 수 있다."},{"id":"section-2","type":"text","role":"section","text":"해양 쓰레기의 유입 경로"},{"id":"text-2","type":"text","text":"바다로 유입된 플라스틱은 바다 위를 떠다니기도 하고, 자외선에 의해 분해되어 미세 플라스틱 형태로 돌아다니면서 해양 생태계를 위협한다."},{"id":"p54-plastic","type":"chart","ref":"p54-plastic"},{"id":"plastic-note-1","type":"text","text":"연간 플라스틱 생산량의 0.5%가 바다에 버려진다."},{"id":"plastic-note-2","type":"text","text":"수만 톤~수십만 톤의 해양 플라스틱 부유물"},{"id":"page-54-plastic","type":"page","page":54,"bbox":[30,293,382,506],"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/page/p054.jpg"},{"id":"garbage-text","type":"text","view":"garbage","text":"태평양의 거대 쓰레기 섬"},{"id":"p54-1","type":"photo","photo":{"id":"p54-1","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p54-1.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p54-1.webp","width":348,"height":149},"title":"태평양의 거대 쓰레기 섬","text":"북태평양에는 한반도 크기의 약 7배(약 160만km²)나 되는 거대한 쓰레기 섬이 존재하며, 주로 플라스틱 쓰레기로 구성되어 있다."},{"id":"section-3","type":"text","role":"section","text":"플라스틱을 줄이기 위한 노력"},{"id":"p54-2","type":"photo","photo":{"id":"p54-2","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p54-2.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p54-2.webp","width":216,"height":211},"text":"태평양 거대 쓰레기 지대를 청소하기 위해 2013년 당시 19살이었던 보얀 슬랫은 비영리 단체인 ‘오션클린업’을 세웠다. 쓰레기 수거 장비를 개발하여 플라스틱 쓰레기를 수거하여 처리하고 있다."},{"id":"p54-3","type":"photo","photo":{"id":"p54-3","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p54-3.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p54-3.webp","width":201,"height":211},"text":"해양 쓰레기로부터 발리를 보호하고자 2013년 당시 12살이었던 멜라티 위즌은 ‘바이바이플라스틱백’이라는 환경 단체를 설립하였다. 현재 발리에서는 비닐봉지, 플라스틱 빨대, 스티로폼의 사용을 금지하고 있다."},{"id":"p54-4","type":"photo","photo":{"id":"p54-4","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p54-4.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p54-4.webp","width":246,"height":219},"text":"기후 변화의 심각성에 대해 알리고자 2018년 당시 15세였던 그레타 툰베리는 매주 금요일마다 등교를 거부하고 시위를 했다. 이후 ‘기후를 위한 학교 파업 시위’는 2019년 125개국 2천여 도시에서 진행되었다."},{"id":"section-4","type":"text","role":"section","text":"기후 변화와 해수면 상승"},{"id":"p54-temp-co2","type":"chart","ref":"p54-temp-co2","text":"이산화 탄소 농도 증가로 세계 평균 기온이 상승하고 있으며, 이로 인한 해수면 상승은 저지대에 거주하는 사람들의 삶의 터전을 위협하고 있다.","note":"* 그래프에 값이 인쇄돼 있지 않아 선 높이를 잰 값이다(기온 편차 약 ±0.014℃, 이산화 탄소 농도 약 ±1.9PPM)."},{"id":"sealevel-text","type":"text","view":"sealevel","text":"남태평양의 해수면 변화 예측"},{"id":"p54-sealevel","type":"chart","ref":"p54-sealevel","note":"* 그래프 점에 값이 인쇄돼 있지 않아 점 높이를 잰 값이다(약 ±0.4cm)."},{"id":"page-54-sealevel","type":"page","page":54,"bbox":[567,424,737,531],"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/page/p054.jpg"},{"id":"p54-5","type":"photo","photo":{"id":"p54-5","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p54-5.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p54-5.webp","width":127,"height":149},"text":"태평양의 섬나라 투발루의 장관은 수중 연설을 통해 기후 위기로 수몰되고 있는 섬나라의 현실을 전 세계에 호소하였다."},{"id":"activity-3","type":"activity","title":"활동하기 3","text":"기후 변화 대응을 위한 저탄소 생활 실천 방법을 찾아보고 캠페인에 활용할 수 있는 홍보물을 포스터, 표어, 카드 뉴스 등 다양한 형식으로 만들어 보자."},{"id":"site-1","type":"text","title":"참고 사이트","text":"탄소 중립 포인트 에너지 https://t25.kr/hpkm"},{"id":"page-54","type":"page","page":54,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/page/p054.jpg"}],"quiz":null},{"id":"arcticRoute","title":"북극의 지리적 중요성","pages":[55],"view":{"map":"p55-claims","center":[-169.741,86.394],"bounds":[-180,57,180,90]},"views":[{"id":"route","label":"북극 항로","map":"p55-route","center":[98.958,60.514],"bounds":[-32.291,-1.395,227.883,75.303]},{"id":"claims","label":"북극해를 둘러싼 영유권 분쟁","map":"p55-claims","center":[-169.741,86.394],"bounds":[-180,57,180,90]}],"layers":[{"ref":"layer-p55-route","type":"pathFlow","legend":true,"group":"map","label":"북극 항로","credit":"(한국 무역 협회, 2022)"},{"ref":"layer-p55-route-cities","type":"symbolLabels","legend":true,"group":"map","label":"북극 항로"},{"ref":"layer-p55-claims-view","type":"topicView","legend":false,"group":"map","label":"북극해를 둘러싼 영유권 분쟁"},{"ref":"layer-p55-claims","type":"area","legend":true,"group":"map","credit":"(해양 수산부, 2021)","legendTitle":"영유권 주장 국가","label":"북극해를 둘러싼 영유권 분쟁"},{"ref":"layer-p55-resources","type":"symbolLabels","legend":true,"group":"map","label":"북극해를 둘러싼 영유권 분쟁"}],"markers":[],"blocks":[{"id":"question","type":"text","role":"question","text":"극지방은 우리에게 왜 중요할까?"},{"id":"goal","type":"text","role":"goal","title":"학습 목표","text":"극지방의 지리적 중요성과 지역 개발을 둘러싼 다양한 이해관계를 살펴보고, 이에 대한 자신과 상대방의 의견을 비판적으로 검토한다."},{"id":"section-1","type":"text","role":"section","text":"북극의 지리적 중요성"},{"id":"route-text","type":"text","view":"route","title":"북극 항로","text":"지구 온난화로 인해 여름철 북극해의 빙하가 녹아 있는 기간이 증가하고 있다. 이에 따라 북극 항로의 이용 일수가 증가할 전망이다."},{"id":"p55-route-stats","type":"chart","ref":"p55-route-stats"},{"id":"claims-text","type":"text","view":"claims","title":"북극해를 둘러싼 영유권 분쟁","text":"북극해에 석유와 천연가스를 비롯한 천연자원이 대규모로 매장되어 있으며, 자원을 둘러싼 인접 국가들의 영유권 분쟁이 나타나고 있다."},{"id":"page-55","type":"page","page":55,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/page/p055.jpg"}],"quiz":null},{"id":"antarcticResearch","title":"남극의 지리적 중요성과 극지 연구","pages":[55],"view":{"map":"p55-treaty","center":[156.738,25.023],"bounds":[-18.029,-51.194,331.505,81.001]},"views":[{"id":"treaty","label":"남극 조약","map":"p55-treaty","center":[156.738,25.023],"bounds":[-18.029,-51.194,331.505,81.001]},{"id":"bases","label":"세계 각국의 남극 연구 기지와 영유권 분쟁","map":"p55-bases","center":[12.669,-89.721],"bounds":[-180,-90,180,-59]},{"id":"araon-s","label":"10월~4월","map":"p55-araon-s","center":[-137.795,-59.842],"bounds":[-180,-75.556,-9.644,1.601]},{"id":"araon-n","label":"7월~9월","map":"p55-araon-n","center":[160.279,39.171],"bounds":[68.493,-17.584,250.888,73.355]}],"layers":[{"ref":"layer-p55-treaty","type":"countryClass","legend":true,"group":"map","credit":"(남극 조약 사무국 누리집, 2023)","label":"남극 조약"},{"ref":"layer-p55-bases-view","type":"topicView","legend":false,"group":"map","label":"세계 각국의 남극 연구 기지와 영유권 분쟁"},{"ref":"layer-p55-sectors","type":"sectorLines","legend":true,"group":"map","credit":"(「청소년을 위한 국가 지도집」, 2022)","label":"세계 각국의 남극 연구 기지와 영유권 분쟁"},{"ref":"layer-p55-bases","type":"symbolLabels","legend":true,"group":"map","label":"세계 각국의 남극 연구 기지와 영유권 분쟁"},{"ref":"layer-p55-araon-s","type":"pathFlow","legend":true,"group":"map","label":"10월~4월","credit":"(「청소년을 위한 대한민국 국가지도집」, 2022)","approx":true,"approxNote":"위치 근사"},{"ref":"layer-p55-araon-s-marks","type":"symbolLabels","legend":false,"group":"map","label":"10월~4월","approx":true,"approxNote":"위치 근사","approxReason":"기준점을 눈으로 찍음(모든 기준점 approx)"},{"ref":"layer-p55-araon-n","type":"pathFlow","legend":true,"group":"map","label":"7월~9월","credit":"(「청소년을 위한 대한민국 국가지도집」, 2022)"},{"ref":"layer-p55-araon-n-marks","type":"symbolLabels","legend":false,"group":"map","label":"7월~9월"}],"markers":[],"blocks":[{"id":"question","type":"text","role":"question","text":"극지방은 우리에게 왜 중요할까?"},{"id":"goal","type":"text","role":"goal","title":"학습 목표","text":"극지방의 지리적 중요성과 지역 개발을 둘러싼 다양한 이해관계를 살펴보고, 이에 대한 자신과 상대방의 의견을 비판적으로 검토한다."},{"id":"section-2","type":"text","role":"section","text":"남극의 지리적 중요성"},{"id":"treaty-text","type":"text","view":"treaty","title":"남극 조약","text":"1959년에 남극 조약이 체결(12개국)되었으며, 2023년 현재 56개국이 가입해 있다. 조약에 의거 2048년까지 평화적, 과학 연구 목적으로만 남극을 이용할 수 있다."},{"id":"bases-text","type":"text","view":"bases","title":"세계 각국의 남극 연구 기지와 영유권 분쟁","text":"2023년 현재 29개국이 남극 대륙에 연구 기지를 운영 중이며, 남극 대륙 주변에 위치하거나 탐험의 역사를 가진 국가들이 남극 대륙에서의 영유권을 주장하고 있다."},{"id":"activity-4","type":"activity","title":"활동하기 4","text":"2048년, 남극 조약의 만료가 다가왔다. 역할극을 통해 각 이해 당사자가 되어 남극의 활용 방안을 토의·토론해 보자."},{"id":"section-3","type":"text","role":"section","text":"우리나라의 극지 연구"},{"id":"sub-1","type":"text","role":"subtitle","text":"우리나라의 극지 과학 기지"},{"id":"p55-1","type":"photo","photo":{"id":"p55-1","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p55-1.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p55-1.webp","width":230,"height":159},"title":"북극 다산 과학 기지","text":"우리나라는 1986년 남극 조약 가입 후, 1988년 남극 세종 기지를 시작으로 2002년 북극 다산 과학 기지, 2014년 남극 장보고 과학 기지를 건설하여 극지 연구를 하고 있다."},{"id":"p55-2","type":"photo","photo":{"id":"p55-2","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p55-2.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p55-2.webp","width":230,"height":159},"title":"남극 세종 과학 기지","text":"우리나라는 1986년 남극 조약 가입 후, 1988년 남극 세종 기지를 시작으로 2002년 북극 다산 과학 기지, 2014년 남극 장보고 과학 기지를 건설하여 극지 연구를 하고 있다."},{"id":"p55-3","type":"photo","photo":{"id":"p55-3","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p55-3.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p55-3.webp","width":230,"height":159},"title":"남극 장보고 과학 기지","text":"우리나라는 1986년 남극 조약 가입 후, 1988년 남극 세종 기지를 시작으로 2002년 북극 다산 과학 기지, 2014년 남극 장보고 과학 기지를 건설하여 극지 연구를 하고 있다."},{"id":"sub-2","type":"text","role":"subtitle","text":"쇄빙선 아라온호"},{"id":"araon-s-text","type":"text","view":"araon-s","text":"(10월~4월)"},{"id":"araon-n-text","type":"text","view":"araon-n","text":"(7월~9월)"},{"id":"page-55-araon","type":"page","page":55,"bbox":[519,284,757,408],"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/page/p055.jpg"},{"id":"p55-4","type":"photo","photo":{"id":"p55-4","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p55-4.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p55-4.webp","width":247,"height":105},"text":"쇄빙 연구선 아라온호는 연구 장비가 설치되어 있어 극지 환경에 대한 연구 활동을 지원하며, 북극과 남극 과학 기지에 보급품을 운반하는 역할을 한다."},{"id":"theme-1","type":"activity","role":"theme","title":"극지 연구소의 연구 활동 알아보기","text":"우리나라 극지 연구소의 누리집에 접속하여 극지 연구소의 활동에 대해 자세히 살펴보자."},{"id":"p55-5","type":"photo","photo":{"id":"p55-5","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p55-5.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p55-5.webp","width":468,"height":292},"text":"쇄빙 연구선 체험(VR)"},{"id":"p55-6","type":"photo","photo":{"id":"p55-6","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p55-6.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p55-6.webp","width":466,"height":291},"text":"남극 세종 과학 기지 체험(VR)"},{"id":"p55-7","type":"photo","photo":{"id":"p55-7","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p55-7.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p55-7.webp","width":467,"height":291},"text":"극지 연구소 메타버스"},{"id":"site-1","type":"text","title":"참고 사이트","text":"극지 연구소 https://t25.kr/6kv2"},{"id":"page-55-theme","type":"page","page":55,"bbox":[30,487,758,693],"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/page/p055.jpg"},{"id":"page-55","type":"page","page":55,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/page/p055.jpg"}],"quiz":null}]
