[{"id":"general","title":"일반도","pages":[48],"view":{"map":"p48-oceania","center":[151.747,-19.742],"bounds":[110.749,-53.689,193.531,13.141]},"views":[{"id":"oceania","label":"오세아니아","map":"p48-oceania","center":[151.747,-19.742],"bounds":[110.749,-53.689,193.531,13.141]},{"id":"hawaii","label":"하와이 제도","map":"p48-hawaii","center":[-157.219,20.837],"bounds":[-161,18.6,-153.5,23.1]},{"id":"tahiti","label":"타히티","map":"p48-tahiti","center":[-151.218,-17.477],"bounds":[-156.3,-21.1,-145.7,-14]}],"layers":[{"ref":"layer-p48-view","type":"topicView","legend":false,"group":"map","label":"오세아니아"},{"ref":"layer-p48-boundaries","type":"area","legend":true,"group":"map","label":"오세아니아"},{"ref":"layer-p48-korea","type":"compareOutline","legend":false,"group":"map","label":"오세아니아"}],"markers":[],"blocks":[{"id":"map-text","type":"text","view":"oceania","title":"오세아니아","text":"람베르트 정적 방위 도법 1:30,000,000"},{"id":"hawaii-text","type":"text","view":"hawaii","title":null,"text":"하와이 제도"},{"id":"tahiti-text","type":"text","view":"tahiti","text":"타히티(프)"},{"id":"outline-text","type":"text","text":"같은 축척과 같은 경도의 우리나라"},{"id":"page-48","type":"page","page":48,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/page/p048.jpg"}],"quiz":null},{"id":"coloring","title":"색칠하기","pages":[49],"view":{"map":"p49-coloring","center":[150.764,-19.871],"bounds":[109.629,-54.025,192.299,12.897]},"layers":[{"ref":"layer-p49-view","type":"topicView","legend":false,"group":"map","label":"오세아니아의 국가와 주요 도시(색칠하기)"}],"markers":[],"blocks":[{"id":"goal","type":"text","role":"goal","title":"학습 목표","text":"다양한 지리 정보와 매체를 활용하여 오세아니아의 국가와 주요 도시의 위치를 표현할 수 있다."},{"id":"text-1","type":"text","title":"오세아니아의 국가와 주요 도시","text":"오세아니아 대륙은 오스트레일리아와 뉴질랜드, 파푸아 뉴기니 등을 포함한 태평양의 여러 섬나라로 이루어져 있다. 오세아니아는 세계에서 가장 작은 대륙으로, 전체 육지 면적이 브라질과 비슷하다. 오스트레일리아와 뉴질랜드는 영국 연방에 속하여 유럽과의 무역 비중이 높았지만, 1980년대 이후 풍부한 광물 및 에너지 자원을 바탕으로 동아시아 국가들과의 무역이 크게 증가하였다."},{"id":"activity-1","type":"activity","text":"각 나라에 색칠하여 지도를 완성하고 각 국가명과 도시명을 써넣어 보자."},{"id":"page-49","type":"page","page":49,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/page/p049.jpg"}],"quiz":{"type":"coloring","page":49,"map":"p49-coloring","countries":[{"name":"오스트레일리아","label":null,"iso":"AUS","neName":"Australia","capital":"캔버라","capitalLonlat":[149.13,-35.28],"capitalFrom":"places"},{"name":"피지","label":"ㅍㅈ","iso":"FJI","neName":"Fiji","labelLonlat":[177.199,-16.5887],"capital":"수바","capitalLonlat":[178.44,-18.13],"capitalFrom":"printed"},{"name":"미크로네시아","label":"미크로네시아","iso":"FSM","neName":"Micronesia","labelLonlat":[150.8342,5.205],"capital":"팔리키르","capitalLonlat":[158.15,6.92],"capitalFrom":"printed"},{"name":"키리바시","label":"ㅋㄹㅂㅅ","iso":"KIR","neName":"Kiribati","labelLonlat":[176.2031,-0.2395],"capital":"타라와","capitalLonlat":[173.08,1.4],"capitalFrom":"printed"},{"name":"마셜 제도","label":"ㅁㅅ ㅈㄷ","iso":"MHL","neName":"Marshall Is.","labelLonlat":[171.82,8.1217],"capital":"마주로","capitalLonlat":[171.38,7.1],"capitalFrom":"printed"},{"name":"나우루","label":"ㄴㅇㄹ","iso":"NRU","neName":"Nauru","labelLonlat":[167.872,-1.6402],"capital":"야렌","capitalLonlat":[166.92,-0.51],"capitalFrom":"printed"},{"name":"뉴질랜드","label":null,"iso":"NZL","neName":"New Zealand","capital":"웰링턴","capitalLonlat":[174.82,-41.29],"capitalFrom":"places"},{"name":"팔라우","label":"ㅍㄹㅇ","iso":"PLW","neName":"Palau","labelLonlat":[134.6087,6.4361],"capital":"응어룰무드","capitalLonlat":[134.53,7.49],"capitalFrom":"printed"},{"name":"파푸아 뉴기니","label":null,"iso":"PNG","neName":"Papua New Guinea","capital":"포트모르즈비","capitalLonlat":[147.18,-9.47],"capitalFrom":"places"},{"name":"솔로몬 제도","label":"ㅅㄹㅁ ㅈㄷ","iso":"SLB","neName":"Solomon Is.","labelLonlat":[163.8841,-9.7227],"capital":"호니아라","capitalLonlat":[159.98,-9.44],"capitalFrom":"printed"},{"name":"통가","label":"ㅌㄱ","iso":"TON","neName":"Tonga","labelLonlat":[-175.3795,-19.4254],"capital":"누쿠알로파","capitalLonlat":[-175.22,-21.14],"capitalFrom":"printed"},{"name":"투발루","label":"ㅌㅂㄹ","iso":"TUV","neName":"Tuvalu","labelLonlat":[-179.2815,-9.679],"capital":"푸나푸티","capitalLonlat":[179.22,-8.52],"capitalFrom":"printed"},{"name":"바누아투","label":"ㅂㄴㅇㅌ","iso":"VUT","neName":"Vanuatu","labelLonlat":[165.0882,-17.9971],"capital":"포트빌라","capitalLonlat":[168.35,-17.73],"capitalFrom":"printed"},{"name":"사모아","label":"ㅅㅁㅇ","iso":"WSM","neName":"Samoa","labelLonlat":[-173.1274,-12.9159],"capital":"아피아","capitalLonlat":[-171.77,-13.84],"capitalFrom":"printed"}]}},{"id":"arctic","title":"북극","pages":[50],"view":{"map":"p50-arctic","center":[38.175,86.432],"bounds":[-180,44,180,90]},"layers":[{"ref":"layer-p50-view","type":"topicView","legend":false,"group":"map","label":"북극 일반도"},{"ref":"layer-p50-lines","type":"area","legend":true,"group":"map","label":"북극 일반도"},{"ref":"layer-p50-dasan","type":"symbolLabels","legend":true,"group":"map","label":"북극 일반도"}],"markers":[],"blocks":[{"id":"map-text","type":"text","title":"북 극","text":"정거 방위 도법 1:39,000,000"},{"id":"page-50","type":"page","page":50,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/page/p050.jpg"}],"quiz":null},{"id":"antarctic","title":"남극","pages":[51],"view":{"map":"p51-antarctic","center":[113.254,-87.405],"bounds":[-180,-90,180,-45]},"layers":[{"ref":"layer-p51-view","type":"topicView","legend":false,"group":"map","label":"남극 일반도"},{"ref":"layer-p51-shelves","type":"area","legend":true,"group":"map","label":"남극 일반도"},{"ref":"layer-p51-lines","type":"area","legend":true,"group":"map","label":"남극 일반도"},{"ref":"layer-p51-stations","type":"symbolLabels","legend":true,"group":"map","label":"남극 일반도"}],"markers":[],"blocks":[{"id":"map-text","type":"text","title":"남 극","text":"정거 방위 도법 1:39,000,000"},{"id":"page-51","type":"page","page":51,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/page/p051.jpg"}],"quiz":null},{"id":"relief","title":"지형","pages":[52],"view":{"map":"p52-relief","center":[139.012,-25.144],"bounds":[100.91,-51.149,177.468,0.606]},"layers":[{"ref":"layer-p52-view","type":"topicView","legend":false,"group":"map","label":"오세아니아의 지형"}],"markers":[{"id":"r-barrier","photo":{"id":"p52-1","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p52-1.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p52-1.webp","width":347,"height":203,"pin":1},"title":"그레이트배리어리프(대보초)","text":"그레이트배리어리프는 세계 최대 규모의 산호초 지역으로, 길이만 약 2,000km 이상이다. 유네스코가 지정한 세계의 자연 유산 중 가장 넓은 규모이다.","lonlat":[146.73732,-17.01023],"lonlatFrom":"pin"},{"id":"r-bluemountain","photo":{"id":"p52-2","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p52-2.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p52-2.webp","width":348,"height":203,"pin":2},"title":"블루마운틴","text":"시드니 근처에 위치한 블루마운틴의 이름은 유칼립투스나무에서 뿜어지는 작은 기름방울이 수증기와 섞여 햇빛을 받으면서 만들어지는 푸른 빛에서 유래되었다.","lonlat":[148.75323,-36.08724],"lonlatFrom":"pin"},{"id":"r-waiotapu","photo":{"id":"p52-3","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p52-3.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p52-3.webp","width":348,"height":203,"pin":3},"title":"와이오타푸","text":"뉴질랜드 북섬에는 지진과 화산 활동이 자주 일어나 화산 지형, 간헐천 등이 발달하였는데, 와이오타푸 지열 지대에는 이를 활용한 관광 산업이 발달하였다.","lonlat":[176.46822,-39.64106],"lonlatFrom":"pin"},{"id":"r-uluru","photo":{"id":"p52-4","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p52-4.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p52-4.webp","width":348,"height":203,"pin":4},"title":"울루루","text":"오스트레일리아 대륙 한가운데 위치한 울루루는 세계에서 가장 큰 규모의 바위산이다. 이 바위산은 원주민인 애버리지니가 신성시 여기는 장소이기도 하다.","lonlat":[131.27163,-25.69789],"lonlatFrom":"pin"},{"id":"r-artesian","photo":{"id":"p52-5","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p52-5.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p52-5.webp","width":348,"height":203,"pin":5},"title":"대찬정 분지","text":"대찬정 분지는 오스트레일리아 중·동부 지역에 펼쳐진 거대한 분지이다. 이 지역에서는 지하수를 활용한 대규모 목축이 이루어지고 있다.","lonlat":[144.7474,-30.65208],"lonlatFrom":"pin"},{"id":"r-oceanroad","photo":{"id":"p52-6","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p52-6.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p52-6.webp","width":348,"height":203,"pin":6},"title":"그레이트 오션 로드","text":"오스트레일리아 빅토리아주의 해안 도로를 따라 다양한 해안 지형이 형성되어 있다. 12사도 바위를 비롯한 해안 경관을 즐기려는 관광객들이 많이 찾는 곳이다.","lonlat":[142.44986,-39.00151],"lonlatFrom":"pin"},{"id":"r-milford","photo":{"id":"p52-7","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p52-7.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p52-7.webp","width":347,"height":203,"pin":7},"title":"밀퍼드 사운드","text":"뉴질랜드 남섬에 위치한 밀퍼드 사운드는 빙하가 깎은 U자곡에 해수면 상승으로 바닷물이 들어와 생긴 피오르이다.","lonlat":[166.87891,-45.14879],"lonlatFrom":"pin"}],"pinNumbers":"hidden","blocks":[{"id":"question","type":"text","role":"question","text":"오세아니아의 자연환경은 어떤 특색을 지니고 있을까?"},{"id":"goal","type":"text","role":"goal","title":"학습 목표","text":"다양한 지리 정보와 매체를 활용하여 오세아니아의 지형과 기후 특색을 지도로 표현할 수 있다."},{"id":"section-1","type":"text","role":"section","text":"오세아니아의 지형","credit":"(naturalearthdata.com, 2023)"},{"id":"activity-1","type":"activity","title":"활동하기 1","text":"48쪽의 오세아니아 지도와 인터넷을 참고하여 사진의 위치를 지도의 빈칸에 표시해 보자."},{"id":"page-52","type":"page","page":52,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/page/p052.jpg"}],"quiz":null},{"id":"climate","title":"기후","pages":[53],"view":{"map":"p53-climate","center":[144.606,-26.301],"bounds":[111.39,-48.509,177.163,-4.927]},"layers":[{"ref":"layer-p53-climate","type":"area","legend":true,"group":"map","credit":"*1991~2020년 평균 (www.gloh2o.org, 2023)","legendTitle":"기후 구분","label":"오세아니아의 기후 구분"},{"ref":"layer-p53-jan","type":"area","legend":true,"group":"map","credit":"*1970~2010년 평균 (www.worldclim.org, 2023)","legendTitle":"강수량(mm)","lineLegendTitle":"기온 (°C)","label":"1월의 평균 기온과 강수량"},{"ref":"layer-p53-jul","type":"area","legend":true,"group":"map","credit":"*1970~2010년 평균 (www.worldclim.org, 2023)","legendTitle":"강수량(mm)","lineLegendTitle":"기온 (°C)","label":"7월의 평균 기온과 강수량"}],"markers":[{"id":"c-darwin","photo":{"id":"p53-1","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p53-1.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p53-1.webp","width":323,"height":210,"pin":1},"title":"다윈의 상점","text":"사바나 기후가 나타나는 다윈은 우기와 건기가 뚜렷하며, 우기에 비를 피하면서 상점을 이용할 수 있는 형태의 건물이 발달하였다.","lonlat":[130.85,-12.42],"lonlatFrom":"place","place":"다윈","textbookLonlat":[130.48129,-13.1495],"chart":"p53-darwin"},{"id":"c-alice","photo":{"id":"p53-2","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p53-2.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p53-2.webp","width":323,"height":210,"pin":2},"title":"오스트레일리아의 아웃백","text":"오스트레일리아의 건조한 내륙 지역을 일컫는 아웃백에서는 다양한 건조 지형과 함께 사막 체험을 할 수 있다.","lonlat":[133.88,-23.7],"lonlatFrom":"place","place":"앨리스스프링스","textbookLonlat":[133.961,-23.95982],"chart":"p53-alice"},{"id":"c-perth","photo":{"id":"p53-3","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p53-3.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p53-3.webp","width":323,"height":210,"pin":3},"title":"퍼스의 포도 농장","text":"지중해성 기후가 나타나는 퍼스에서는 포도 재배가 활발하여 고품질의 와인을 생산한다.","lonlat":[115.87,-31.98],"lonlatFrom":"place","place":"퍼스","textbookLonlat":[115.8484,-32.11095],"chart":"p53-perth"},{"id":"c-christchurch","photo":{"id":"p53-4","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p53-4.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u6/photo/p53-4.webp","width":323,"height":210,"pin":4},"title":"뉴질랜드의 목축업","text":"뉴질랜드 남섬의 캔터베리 지방에서는 양을 기르는 목축업이 활발히 이루어진다.","lonlat":[172.63,-43.53],"lonlatFrom":"place","place":"크라이스트처치","textbookLonlat":[172.63408,-43.45686],"chart":"p53-christchurch"}],"pinNumbers":"hidden","blocks":[{"id"