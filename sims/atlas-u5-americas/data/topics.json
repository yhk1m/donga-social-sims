3,40.46128],"chart":"p45-newyork"},{"id":"c-bogota","photo":{"id":"p45-3","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p45-3.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p45-3.webp","width":334,"height":200,"pin":3},"title":"안데스 산지의 원주민들","text":"열대 지역에 위치한 안데스 산지는 해발 고도가 높아 연중 15°C 내외의 기온이 지속된다. 쾌적한 기후의 영향으로 이 지역에는 일찍부터 도시와 고대 문명이 발달하였다.","lonlat":[-74.09,4.6],"lonlatFrom":"place","place":"보고타","textbookLonlat":[-73.88141,5.44472],"chart":"p45-bogota"},{"id":"c-iquitos","photo":{"id":"p45-4","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p45-4.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p45-4.webp","width":334,"height":200,"pin":4},"title":"아마존의 열대 우림","text":"아마존강 유역의 열대 우림 기후 지역에는 지구에서 가장 넓은 열대 우림이 펼쳐져 있으며, 다양한 생물종의 보고이다.","lonlat":[-73.25,-3.75],"lonlatFrom":"place","place":"이키토스","textbookLonlat":[-73.59457,-3.48456],"chart":"p45-iquitos"}],"pinNumbers":"hidden","blocks":[{"id":"question","type":"text","role":"question","text":"아메리카의 자연환경은 어떤 특색을 지니고 있을까?"},{"id":"goal","type":"text","role":"goal","title":"학습 목표","text":"다양한 지리 정보와 매체를 활용하여 아메리카의 지형과 기후 특색을 지도로 표현할 수 있다."},{"id":"section-1","type":"text","role":"section","text":"아메리카의 기후"},{"id":"activity-1","type":"activity","title":"활동하기 2","text":"기후 그래프와 사진 설명을 읽고 해당 지역의 위치를 지도에 표시해 보자."},{"id":"page-45","type":"page","page":45,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/page/p045.jpg"}],"quiz":null},{"id":"migration","title":"인구 이동과 언어","pages":[46],"view":{"map":"p46-migration","center":[-30.439,10.722],"bounds":[-94.21,-44.713,35.872,60.783]},"views":[{"id":"flows","label":"아메리카 인구 이동","map":"p46-migration","center":[-30.439,10.722],"bounds":[-94.21,-44.713,35.872,60.783]},{"id":"canada","label":"캐나다의 언어 분포","map":"p46-canada","center":[-91.788,62.575],"bounds":[-141.679,40.201,-39.741,76.772]}],"layers":[{"ref":"layer-p46-colonies","type":"area","legend":true,"group":"map","label":"아메리카 인구 이동","credit":"(『세계의 여러 지역 NOW』, 2023)","legendTitle":"17세기까지의 식민지 지역"},{"ref":"layer-p46-migration-flows","type":"pathFlow","legend":true,"group":"map","label":"아메리카 인구 이동"},{"ref":"layer-p46-canada","type":"area","legend":true,"group":"map","label":"캐나다의 언어 분포","credit":"(캐나다 통계청, 2016)"}],"markers":[],"blocks":[{"id":"question","type":"text","role":"question","text":"아메리카에서는 어떤 민족들이 어떤 문화를 이루며 살아갈까?"},{"id":"goal","type":"text","role":"goal","title":"학습 목표","text":"다양한 민족(인종)으로 구성된 아메리카의 인구 특징을 살펴보고, 사례를 들어 아메리카의 문화 혼종성을 설명할 수 있다."},{"id":"section-1","type":"text","role":"section","text":"아메리카 인구 이동"},{"id":"text-1","type":"text","view":"flows","text":"원주민이 거주하던 아메리카에 유럽계 민족이 이주하면서 식민 지배에 필요한 노동력을 확보하기 위해 아프리카계 민족을 강제 이주시킴으로써 아메리카에는 다양한 민족이 거주하게 되었다."},{"id":"page-46-part","type":"page","page":46,"bbox":[30,75,265,222],"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/page/p046.jpg"},{"id":"section-2","type":"text","role":"section","text":"캐나다의 언어 분포"},{"id":"text-2","type":"text","view":"canada","text":"캐나다는 영어와 프랑스어를 공용어로 채택하고 있으며, 프랑스계의 정착이 활발했던 퀘벡주는 프랑스어 사용 인구 비율이 상대적으로 높다."},{"id":"page-46","type":"page","page":46,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/page/p046.jpg"}],"quiz":null},{"id":"ethnicity","title":"민족 구성과 문화 혼종성","pages":[46],"view":{"map":"p46-us-european","center":[-97.319,38.407],"bounds":[-122.728,25.165,-71.25,49.819]},"views":[{"id":"european","label":"유럽계 인구 비율(%)","map":"p46-us-european","center":[-97.319,38.407],"bounds":[-122.728,25.165,-71.25,49.819]},{"id":"african","label":"아프리카계 인구 비율(%)","map":"p46-us-african","center":[-97.319,38.407],"bounds":[-122.728,25.165,-71.25,49.819]},{"id":"hispanic","label":"히스패닉계 인구 비율(%)","map":"p46-us-hispanic","center":[-97.319,38.407],"bounds":[-122.728,25.165,-71.25,49.819]},{"id":"asian","label":"아시아계 인구 비율(%)","map":"p46-us-asian","center":[-97.319,38.407],"bounds":[-122.728,25.165,-71.25,49.819]},{"id":"ethnic","label":"중앙 및 남아메리카의 민족(인종) 다양성","map":"p46-ethnic","center":[-78.363,-10.874],"bounds":[-118.888,-50.749,-34.628,32.699]}],"layers":[{"ref":"layer-p46-us-european","type":"area","legend":true,"group":"map","label":"유럽계 인구 비율(%)","credit":"(미국 통계청, 2020)","legendTitle":"유럽계 인구 비율(%)"},{"ref":"layer-p46-us-african","type":"area","legend":true,"group":"map","label":"아프리카계 인구 비율(%)","credit":"(미국 통계청, 2020)","legendTitle":"아프리카계 인구 비율(%)"},{"ref":"layer-p46-us-hispanic","type":"area","legend":true,"group":"map","label":"히스패닉계 인구 비율(%)","credit":"(미국 통계청, 2020)","legendTitle":"히스패닉계 인구 비율(%)"},{"ref":"layer-p46-us-asian","type":"area","legend":true,"group":"map","label":"아시아계 인구 비율(%)","credit":"(미국 통계청, 2020)","legendTitle":"아시아계 인구 비율(%)"},{"ref":"layer-p46-ethnic","type":"area","legend":true,"group":"map","label":"중앙 및 남아메리카의 민족(인종) 다양성","credit":"(『신상 지리 자료』, 2023)","note":"*가로 안의 숫자는 각 국가의 인구(만 명)임."},{"ref":"layer-p46-ethnic-rings","type":"chartSymbols","legend":false,"group":"map","label":"중앙 및 남아메리카의 민족(인종) 다양성"}],"markers":[],"blocks":[{"id":"question","type":"text","role":"question","text":"아메리카에서는 어떤 민족들이 어떤 문화를 이루며 살아갈까?"},{"id":"goal","type":"text","role":"goal","title":"학습 목표","text":"다양한 민족(인종)으로 구성된 아메리카의 인구 특징을 살펴보고, 사례를 들어 아메리카의 문화 혼종성을 설명할 수 있다."},{"id":"section-3","type":"text","role":"section","text":"미국의 민족(인종) 분포 및 구성"},{"id":"p46-us-ethnic","type":"chart","ref":"p46-us-ethnic","text":"미국은 시간이 지남에 따라 유럽계의 인구 비율이 감소하고 다른 민족(인종) 인구 비율이 증가하고 있다."},{"id":"section-4","type":"text","role":"section","text":"중앙 및 남아메리카의 민족(인종) 다양성"},{"id":"section-5","type":"text","role":"section","text":"아메리카의 문화 혼종성"},{"id":"p46-1","type":"photo","photo":{"id":"p46-1","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p46-1.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p46-1.webp","width":313,"height":168},"title":"재즈(미국)","text":"재즈는 아프리카 전통 음악과 미국 군악대 연주 기법이 결합해 탄생하였다."},{"id":"p46-2","type":"photo","photo":{"id":"p46-2","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p46-2.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p46-2.webp","width":312,"height":168},"title":"리우 카니발(브라질)","text":"리우 카니발은 유럽의 사순절 축제에 아프리카의 전통 연주와 춤이 결합되어 만들어졌다."},{"id":"p46-3","type":"photo","photo":{"id":"p46-3","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p46-3.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p46-3.webp","width":310,"height":168},"title":"산토도밍고 교회(페루)","text":"이 건물은 고대 잉카 시대 태양의 신전이었던 코리칸차의 석벽 위에 세운 유럽 양식의 교회이다."},{"id":"p46-4","type":"photo","photo":{"id":"p46-4","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p46-4.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p46-4.webp","width":183,"height":269},"title":"멕시코의 과달루페 성모","text":"과달루페 대성당에 보관된 성모화로, 검은색 머리카락, 갈색의 눈과 피부색의 모습을 하고 있다."},{"id":"p46-5","type":"photo","photo":{"id":"p46-5","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p46-5.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p46-5.webp","width":183,"height":271},"title":"퀘벡의 프랑스어·영어 공존","text":"캐나다는 영어, 프랑스어를 공용어로 사용하고 있다. 과거 프랑스계의 정착이 활발했던 퀘벡주는 프랑스어 사용 인구 비율이 높다."},{"id":"p46-6","type":"photo","photo":{"id":"p46-6","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p46-6.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p46-6.webp","width":280,"height":139},"text":"미국 남부에서 볼 수 있는 영어와 에스파냐어로 함께 표시한 광고물이다."},{"id":"activity-3","type":"activity","title":"활동하기 3","text":"사진은 미국 남부에서 볼 수 있는 영어와 에스파냐어로 함께 표시한 광고물이다. 이러한 언어는 스팽글리시라고도 불리는데, 스팽글리시가 미국 남부 지역에서 많이 사용되는 이유를 생각해 보자."},{"id":"page-46","type":"page","page":46,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/page/p046.jpg"}],"quiz":null},{"id":"tnc","title":"초국적 기업","pages":[47],"view":{"map":"p47-hq","center":[161.726,18.266],"bounds":[-11.189,-60.119,329.573,80.307]},"views":[{"id":"hq","label":"세계 100대 초국적 기업의 본사 위치","map":"p47-hq","center":[161.726,18.266],"bounds":[-11.189,-60.119,329.573,80.307]},{"id":"supply","label":"미국에 본사를 둔 농업 회사","map":"p47-agri","center":[156.497,25.209],"bounds":[-17.31,-50.228,310.991,80.628]}],"layers":[{"ref":"layer-p47-hq","type":"symbolLabels","legend":true,"group":"map","label":"세계 100대 초국적 기업의 본사 위치","credit":"(LANDGEIST 누리집, 2021)","legendTitle":"기업 규모 (시가 총액, 백억 달러)"},{"ref":"layer-p47-hq-sv","type":"symbol","legend":true,"group":"map","label":"세계 100대 초국적 기업의 본사 위치"},{"ref":"layer-p47-agri-supply","type":"countryClass","legend":true,"group":"map","label":"미국에 본사를 둔 농업 회사","credit":"(D사 누리집, 2023)"},{"ref":"layer-p47-agri-sites","type":"symbolLabels","legend":true,"group":"map","label":"미국에 본사를 둔 농업 회사"}],"markers":[],"blocks":[{"id":"question","type":"text","role":"question","text":"아메리카의 산업이 발달한 지역은 어떻게 변화하고 있을까?"},{"id":"goal","type":"text","role":"goal","title":"학습 목표","text":"초국적 기업의 글로벌 생산 체제에 대한 이해를 바탕으로, 초국적 기업의 아메리카 지역 내 입지와 해외 이전의 이유, 그에 따른 해당 지역의 변화를 설명할 수 있다."},{"id":"section-1","type":"text","role":"section","text":"초국적 기업의 공간적 분업"},{"id":"p47-1","type":"photo","photo":{"id":"p47-1","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p47-1.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p47-1.webp","width":720,"height":439},"text":"초국적 기업의 공간적 분업"},{"id":"page-47-comic","type":"page","page":47,"bbox":[44,95,389,305],"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/page/p047.jpg"},{"id":"section-2","type":"text","role":"section","text":"세계 100대 초국적 기업의 본사 위치"},{"id":"hq-text","type":"text","view":"hq","text":"초국적 기업의 본사는 미국, 유럽, 동아시아 등 경제 발달 지역을 중심으로 주로 분포하며 특히, 미국 서부 지역은 실리콘 밸리를 중심으로 첨단 기술 관련 초국적 기업이 집중되어 있다."},{"id":"section-3","type":"text","role":"section","text":"초국적 기업의 글로벌 생산 체제"},{"id":"text-3","type":"text","text":"초국적 기업은 세계적 차원에서 생산 체제를 갖추고 제품을 생산하고 판매하는 기업이다. 본사는 선진국에 주로 분포하며, 제품 생산 공장은 저렴한 노동력이 풍부한 개발 도상국에 주로 입지한다."},{"id":"p47-2","type":"photo","photo":{"id":"p47-2","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p47-2.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p47-2.webp","width":965,"height":373,"credit":"(A사 누리집, 2023)"},"title":"미국에 본사를 둔 정보 통신 기업","text":"미국 캘리포니아에 본사와 연구소를 둔 A사는 전 세계 50개 이상의 국가에서 제품 생산 과정을 나누어 담당하고 있다."},{"id":"page-47-device","type":"page","page":47,"bbox":[44,366,391,500],"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/page/p047.jpg"},{"id":"agri-text","type":"text","view":"supply","title":"미국에 본사를 둔 농업 회사","text":"미국 캘리포니아에 본사와 연구소를 둔 D사는 기후 여건이 좋고 노동력이 저렴한 지역에 농장을 두고, 경제 규모가 크고 구매력이 큰 지역에 판매 지점을 운영하고 있다."},{"id":"page-47","type":"page","page":47,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/page/p047.jpg"}],"quiz":null},{"id":"change","title":"지역 변화","pages":[47],"view":{"map":"p47-maquila","center":[-101.244,24.658],"bounds":[-116.24,14.387,-86.692,34.256]},"views":[{"id":"maquila","label":"멕시코의 생산 공장 유치에 따른 지역 성장","map":"p47-maquila","center":[-101.244,24.658],"bounds":[-116.24,14.387,-86.692,34.256]}],"layers":[{"ref":"layer-p47-maquila","type":"unitSymbols","legend":true,"group":"map","credit":"(『하크 세계 지도』, 2023)","legendTitle":"마킬라도라 시설*(2021년)","note":"*주로 미국 수출을 목적으로 수입한 부품으로 완제품을 생산하는 조립업체","label":"마킬라도라 시설(2021년)"},{"ref":"layer-p47-mex-states","type":"area","legend":true,"group":"map","label":"마킬라도라 시설(2021년)"}],"markers":[],"blocks":[{"id":"question","type":"text","role":"question","text":"아메리카의 산업이 발달한 지역은 어떻게 변화하고 있을까?"},{"id":"goal","type":"text","role":"goal","title":"학습 목표","text":"초국적 기업의 글로벌 생산 체제에 대한 이해를 바탕으로, 초국적 기업의 아메리카 지역 내 입지와 해외 이전의 이유, 그에 따른 해당 지역의 변화를 설명할 수 있다."},{"id":"section-4","type":"text","role":"section","text":"초국적 기업의 이전에 따른 지역 변화"},{"id":"sub-1","type":"text","role":"subtitle","text":"생산 공장 이전에 따른 지역 쇠퇴"},{"id":"p47-detroit","type":"chart","ref":"p47-detroit","note":"* 그래프 점에 값이 인쇄돼 있지 않아 선 높이를 잰 값이다(약 ±0.3만 명)."},{"id":"p47-3","type":"photo","photo":{"id":"p47-3","url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p47-3.jpg","webp":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/photo/p47-3.webp","width":348,"height":203},"title":"폐허가 된 옛 공장 건물","text":"미국 자동차 산업의 중심지였던 디트로이트는 1960년대 일본 자동차 업계의 미국 시장 진출로 쇠퇴하기 시작하였다. 많은 생산 공장이 폐쇄됨에 따라 극심한 경기 침체를 겪었고, 2014년에는 도시 파산을 선언하기도 하였다."},{"id":"sub-2","type":"text","role":"subtitle","text":"멕시코의 생산 공장 유치에 따른 지역 성장"},{"id":"maquila-text","type":"text","view":"maquila","text":"멕시코는 1960년대부터 수출 진흥 정책을 추진하였다. 이후 미국과의 국경 지대에 저임금 노동력을 활용하는 공장과 일자리가 크게 증가하였다."},{"id":"sub-3","type":"text","role":"subtitle","text":"필리핀의 서비스 산업 유치에 따른 지역 성장"},{"id":"p47-bpo-revenue","type":"chart","ref":"p47-bpo-revenue","text":"미국을 비롯한 세계 각국의 초국적 기업의 콜센터가 필리핀으로 이전하였다. 필리핀은 저렴한 임금, 뛰어난 영어 구사 능력, 시차 등의 좋은 입지 조건을 갖춘 지역으로 꼽힌다.","note":"* 막대 위에 값이 인쇄돼 있지 않아 막대 높이를 잰 값이다(약 ±0.07십억 달러)."},{"id":"p47-bpo-jobs","type":"chart","ref":"p47-bpo-jobs","note":"* 그래프 점에 값이 인쇄돼 있지 않아 선 높이를 잰 값이다(약 ±0.003백만 명)."},{"id":"page-47","type":"page","page":47,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u5/page/p047.jpg"}],"quiz":null}]
