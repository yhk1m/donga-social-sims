[{"id":"general","title":"일반도","pages":[26],"view":{"map":"p26-europe","center":[17.599,52.615],"bounds":[-20.556,31.65,55.817,69.314]},"layers":[],"markers":[],"blocks":[{"id":"map-text","type":"text","title":"유럽","text":"람베르트 정각 원뿔 도법 1:20,000,000"},{"id":"page-26","type":"page","page":26,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u3/page/p026.jpg"}],"quiz":null},{"id":"coloring","title":"색칠하기","pages":[27],"view":{"map":"p27-coloring","center":[17.229,53.151],"bounds":[-21.562,32.141,56.113,69.761]},"layers":[],"markers":[],"blocks":[{"id":"goal","type":"text","role":"goal","title":"학습 목표","text":"다양한 지리 정보와 매체를 활용하여 유럽의 국가와 주요 도시의 위치를 표현할 수 있다."},{"id":"text-1","type":"text","title":"유럽의 국가와 주요 도시","text":"유럽 대륙의 동쪽은 우랄산맥과 카스피해, 흑해 등을 경계로 아시아 대륙과 연결되어 있으며, 남쪽은 지중해를 사이에 두고 아프리카 대륙과 접해 있다. 유럽과 아시아는 육지로 연결되어 있기 때문에 유라시아 대륙이라고도 불리지만, 민족과 언어, 종교 등 문화적 특징이 뚜렷이 구별되어 유럽과 아시아 대륙으로 구분한다. 일찍부터 산업이 발달한 유럽 대륙은 국제 정치와 경제에 큰 영향을 미치는 국가와 도시가 많다."},{"id":"activity-1","type":"activity","text":"각 나라에 색칠하여 지도를 완성하고 각 국가명과 도시명을 써넣어 보자."},{"id":"page-27","type":"page","page":27,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u3/page/p027.jpg"}],"quiz":{"type":"coloring","page":27,"map":"p27-coloring","countries":[{"name":"알바니아","label":"알바니아","iso":"ALB","neName":"Albania","labelLonlat":[19.4434,40.835],"capital":"티라나","capitalLonlat":[19.83,41.33],"capitalFrom":"printed"},{"name":"안도라","label":"안도라","iso":"AND","neName":"Andorra","labelLonlat":[3.0846,43.1285],"labelIso":"FRA","capital":"안도라라베야","capitalLonlat":[1.57,42.52],"capitalFrom":"printed"},{"name":"오스트리아","label":"ㅇㅅㅌㄹㅇ","iso":"AUT","neName":"Austria","labelLonlat":[14.2517,47.3567],"capital":"빈","capitalLonlat":[16.36,48.2],"capitalFrom":"printed"},{"name":"벨기에","label":"ㅂㄱㅇ","iso":"BEL","neName":"Belgium","labelLonlat":[4.9846,50.276],"capital":"브뤼셀","capitalLonlat":[4.37,50.83],"capitalFrom":"printed"},{"name":"불가리아","label":"ㅂㄱㄹㅇ","iso":"BGR","neName":"Bulgaria","labelLonlat":[25.3636,42