[{"id":"general","title":"일반도","pages":[16,18,19],"view":{"map":"p16-asia","center":[92.331,32.753],"bounds":[3.083,-11.664,173.142,73.913]},"views":[{"id":"asia","label":"아시아 전체","map":"p16-asia","center":[92.331,32.753],"bounds":[3.083,-11.664,173.142,73.913]},{"id":"east-asia","label":"동아시아","map":"p18-east-asia","center":[119.323,34.994],"bounds":[95.587,16.983,143.304,51.551]},{"id":"southeast-asia","label":"동남아시아","map":"p19-southeast-asia","center":[117.067,8.3],"bounds":[92.814,-12.142,141.747,29.029]}],"layers":[],"markers":[],"blocks":[{"id":"asia-text","type":"text","view":"asia","title":"아시아","text":"람베르트 정적 방위 도법 1:40,000,000"},{"id":"east-asia-text","type":"text","view":"east-asia","title":"동아시아","text":"람베르트 정각 원뿔 도법 1:16,000,000"},{"id":"southeast-asia-text","type":"text","view":"southeast-asia","title":"동남아시아","text":"람베르트 정적 방위 도법 1:20,000,000"},{"id":"page-16","type":"page","page":16,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u2/page/p016.jpg"},{"id":"page-18","type":"page","page":18,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u2/page/p018.jpg"},{"id":"page-19","type":"page","page":19,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u2/page/p019.jpg"}],"quiz":null},{"id":"coloring","title":"색칠하기","pages":[17],"view":{"map":"p17-coloring","center":[90.585,32.654],"bounds":[1.198,-11.468,170.774,73.414]},"layers":[],"markers":[],"blocks":[{"id":"goal","type":"text","role":"goal","title":"학습 목표","text":"다양한 지리 정보와 매체를 활용하여 아시아의 국가와 주요 도시의 위치를 표현할 수 있다."},{"id":"text-1","type":"text","title":"아시아의 국가와 주요 도시","text":"세계에서 가장 큰 대륙인 아시아는 남북으로 인도네시아에서 러시아의 시베리아, 동서로 일본에서 튀르키예 및 아라비아반도에 걸쳐 있다. 아시아 대륙은 다시 동아시아와 동남아시아, 남부 아시아, 서남아시아, 중앙아시아로 구분된다. 이들 지역은 각 지역별로 지형과 기후 등의 자연환경과 민족, 언어, 종교, 의식주 등의 문화적 특징이 매우 다양하게 나타나기 때문에 지역에 따라 독특한 주민의 삶의 모습을 볼 수 있다."},{"id":"activity-1","type":"activity","text":"각 나라에 색칠하여 지도를 완성하고 각 국가명과 도시명을 써넣어 보자."},{"id":"page-17","type":"page","page":17,"url":"https://yhk1m.github.io/donga-social-sims/assets/atlas/u2/page/p017.jpg"}],"quiz":{"type":"coloring","page":17,"map":"p17-coloring","countries":[{"name":"아프가니스탄","label":"ㅇㅍㄱㄴㅅㅌ","iso":"AFG","neName":"Afghanistan","labelLonlat":[65.3155,32.9762],"capital":"카불","capitalLonlat":[69.18,34.52],"capitalFrom":"places"},{"name":"아랍 에미리트","label":"아랍 에미리트","iso":"ARE","neName":"United Arab Emirates","labelLonlat":[56.4688,25.2885],"capital":"아부다비","capitalLonlat":[54.37,24.47],"capitalFrom":"printed"},{"name":"아르메니아","label":"아르메니아","iso":"ARM","neName":"Armenia","labelLonlat":[41.8842,40.4536],"labelIso":"TUR","capital":"예레반","capitalLonlat":[44.51,40.16],"capitalFrom":"printed"},{"name":"아제르바이잔","label":"아제르바이잔","iso":"AZE","neName":"Azerbaijan","labelLonlat":[45.9049,39.1358],"capital":"바쿠","capitalLonlat":[49.86,40.37],"capitalFrom":"printed"},{"name":"방글라데시","label":"ㅂㄱㄹㄷㅅ","iso":"BGD","neName":"Bangladesh","labelLonlat":[90.1501,24.4889],"capital":"다카","capitalLonlat":[90.45,23.75],"capitalFrom":"printed"},{"name":"바레인","label":"바레인","iso":"BHR","neName":"Bahrain","labelLonlat":[51.9601,27.1941],"capital":"마나마","capitalLonlat":[50.56,26.23],"capitalFrom":"printed"},{"name":"브루나이","label":"브루나이","iso":"BRN","neName":"Brunei","labelLonlat":[115.0573,5.83],"capital":"반다르스리브가완","capitalLonlat":[114.93,4.88],"capitalFrom":"printed"},{"name":"부탄","label":"ㅂㅌ","iso":"BTN","neName":"Bhutan","labelLonlat":[90.413,28.3812],"labelIso":"CHN","capital":"팀푸","capitalLonlat":[89.76,27.47],"capitalFrom":"printed"},{"name":"중국","label":"ㅈ ㄱ","iso":"CHN","neName":"China","labelLonlat":[104.5299,33.8299],"capital":"베이징","capitalLonlat":[116.41,39.94],"capitalFrom":"places"},{"name":"조지아","label":"조지아","iso":"GEO","neName":"Georgia","labelLonlat":[43.6247,43.2808],"labelIso":"RUS","capital":"트빌리시","capitalLonlat":[44.79,41.69],"capitalFrom":"printed"},{"name":"인도네시아","label":"ㅇㄷㄴㅅㅇ","iso":"IDN","neName":"Indonesia","labelLonlat":[113.7617,-5.0644],"capital":"자카르타","capitalLonlat":[106.83,-6.17],"capitalFrom":"plac