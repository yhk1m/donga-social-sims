    "leaderNearPt": 12, "leaderDashPrefix": "[ 0", "leaderJoinPt": 2}},
  "p24-resources": {"map": "p24-resources", "type": "symbol", "mode": "symbols", "glyphMax": 6.0, "legendMaxArea": 40, "expectLegend": 6,
   "legendShapes": {"철광석": "diamond", "구리": "diamond", "주석": "diamond", "석유": "circle", "천연가스": "triangle-down", "석탄": "square"},
   "_legendShapes": "교과서 기호 모양(지면에서 눈으로 확인): 금속 광물 = 마름모, 석유 = 원, 천연가스 = 거꾸로 선 세모, 석탄 = 네모. 앱 기호·범례 견본이 쓴다."},
  "p24-exports": {"map": "p24-exports", "type": "area", "mode": "vector", "tol": 0.15, "minArea": 0.25, "expectLegend": 5},
  "p24-trade": {"map": "p24-trade", "type": "flow", "mode": "vector", "tol": 0.45, "minArea": 2.5, "expectLegend": 9,
   "legendOrder": "rows", "legendSkip": ["#0066b3", "#ed0c6e"],
   "flows": {
    "_doc": "짙은 초록·짙은 빨강 화살표는 따로 된 범례가 아니라 초록 나라 위에 겹친 수입(파랑)·수출(빨강). 상대국 끝점(지면 pt): 수출 = 화살촉 끝, 수입 = 꼬리 끝(600dpi 확대·골격 끝점에서 읽음).",
    "hub": [297.4, 600.0],
    "unitTextRe": "수출입액\\((.+)\\)",
    "classes": {
     "import": {"label": "수입", "legendColor": "#0066b3",
      "fills": ["#0066a6", "#0066b3", "#00656e", "#056543", "#006557", "#006579", "#00649f", "#00669b", "#00668f", "#00636d", "#333376"],
      "partners": [["중국", [288.8, 591.7]], ["미국", [411.3, 592.8]], ["일본", [304.9, 602.7]], ["오스트레일리아", [300.8, 654.7]],
                   ["사우디아라비아", [231.8, 615.0]], ["타이완", [290.9, 612.1]], ["독일", [193.7, 586.1]], ["베트남", [276.3, 616.6]],
                   ["카타르", [229.4, 611.4]], ["인도네시아", [281.9, 641.3]]]},
     "export": {"label": "수출", "legendColor": "#ed0c6e",
      "fills": ["#ed0f67", "#9e2d33", "#b72749", "#af2a3c", "#ed1844", "#dd1767", "#333376"],
      "partners": [["중국", [277.9, 603.1]], ["미국", [401.2, 598.2]], ["베트남", [280.1, 621.3]], ["일본", [306.3, 601.3]],
                   ["홍콩", [284.6, 613.4]], ["타이완", [291.8, 613.3]], ["싱가포르", [277.3, 632.1]], ["인도", [253.9, 613.3]],
                   ["오스트레일리아", [302.7, 655.1]], ["멕시코", [411.8, 614.2]]]}},
    "maskPxPerPt": 6.0, "hubRadiusPt": 6.0, "maxSnapPt": 1.0, "simplifyPt": 0.2,
    "widthWindow": [0.2, 0.5], "widthSkipEndPt": 3.0}}
 },
 "cityControls": {
  "_doc": "일반도(16·18·19쪽) 경위도 맞추기의 도시 기호 기준점(src:'city', city_controls.mjs). 경위선 교차점이 지도 안쪽에만 있어 가장자리 도시가 수십~100km 어긋나서(18쪽 에르데네트 108km), 교과서 도시 기호를 Natural Earth 10m 인구 지점(NAME_KO 같고 아시아 범위에 하나뿐, 그 지도에도 하나뿐)과 짝지어 더한다. 잘못 짝지은 것은 투영식 잔차 MAD(madK) → 이웃 잔차 벡터 일치(localK·localFloorPt) 로 거르고, 교차점 껍질 바깥부터 minSpacingPt 간격으로 성기게 고른다. 고른 점은 maps_u2.json controls 에 적힌다. 겹 나누기(folds) 검증 결과는 계획서 실행 중 결정.",
  "maps": ["p16-asia", "p18-east-asia", "p19-southeast-asia"],
  "note": "controls 의 src:'city' 는 교과서 도시 기호 위치 ↔ Natural Earth 10m 인구 지점 경위도 짝(scripts/atlas/city_controls.mjs 가 고름). 경위선 교차점(src:'grid')이 지도 안쪽에만 있어 가장자리를 붙잡으려고 더했다. 교과서가 일부러 옮겨 그린 기호(에르데네트·냐짱 등)는 잔차로 걸러 기준점에서 뺐다.",
  "madK": 3.0,
  "madFloorPt": 0.3,
  "localK": 4,
  "localFloorPt": 3.0,
  "minSpacingPt": 30,
  "folds": 5,
  "seed": 7
 },
 "places": {
  "_doc": "일반도 지명(Task C2). places.py(PDF → 지면 글자·기호, $ATLAS_WORK/text/places-<map>.json; --index → $ATLAS_WORK/tables/index.json) → build_places.mjs(경위도·중복 합치기·등급·찾아보기 대조 → <out>/places.json). 규칙은 16·18·19쪽 렌더와 글자 양식 표(글꼴·크기·색)를 보고 정했다. ignore 를 먼저 보고, 그다음 styles 에서 처음 맞는 것. 어디에도 안 맞는 글자는 경고로 남는다.",
  "maps": ["p16-asia", "p18-east-asia", "p19-southeast-asia"],
  "overview": "p16-asia",
  "out": "places.json",
  "index": {"pages": [105, 111], "out": "tables/index.json", "nameFont": "^YDVYGOStd33$", "refRe": "(\\d{2})([A-Z])(\\d{1,2})", "checkPages": [16, 19]},
  "ignore": [
   {"font": "^DINPro-Regular$", "color": "#231f20", "textRe": "^[0-9]{3,4}$", "elevation": true, "why": "산 높이(m) — 산 지명에 elev 로 붙임"},
   {"font": "^DINPro", "why": "숫자·라틴 기호: 경위도 눈금, 찾기 격자(A~N, 1~10), 축척"},
   {"font": "^(GodoM|GaramondPremrPro|YDVYGOStd34)", "why": "쪽 제목·단원 표시·쪽 번호"},
   {"color": "#fff56d", "why": "쪽 제목"},
   {"color": "#ffffff", "why": "축척 막대 글자"},
   {"color": "#d71920", "why": "세계 유산 이름(지명이 아니라 유산; 기호는 별도)"},
   {"color": "#6d6e71", "why": "철도 이름(18쪽)"},
   {"font": "^YDVYGOStd3[23]$", "color": "#0072bc", "why": "유빙 한계(선 이름)"},
   {"font": "^YDVYGOStd33$", "size": [5.6, 5.8], "why": "북극권·북회귀선·적도·날짜 변경선(선 이름)과 축척 쌍점"},
   {"font": "^YDVYGOStd3[23]$", "size": [0, 5.5], "why": "범례 글자(육지 높이·바다 깊이·빙하)·한자 병기(東京)·도법 이름"},
   {"font": "^YDVYMjOStd3[23]$", "color": "#231f20", "size": [0, 5.5], "why": "괄호 안 다른 이름 병기(쯔엉사 군도, 스프래틀리 군도, …)"},
   {"font": "^YDVYMjOStd32$", "color": "#ed1064", "why": "나라 소속 표시((인), (러), (예멘))"}
  ],
  "styles": [
   {"role": "country", "font": "^InterGTOTFB", "color": "#ed1064", "joinEm": 1.6, "_": "나라: 굵은 고딕 자홍(12.4~5.6pt)"},
   {"role": "countryEn", "font": "^HelveticaNeue", "color": "#ed1064", "attachTo": ["country"], "maxDistEm": 3.0},
   {"role": "cityEn", "font": "^HelveticaNeue", "color": "#231f20", "attachTo": ["city"], "attachSymbol": "capital", "maxDistEm": 3.0, "_": "수도 영문 이름"},
   {"role": "waterEn", "font": "^TimesNewRoman", "color": "#0072bc", "attachTo": ["water"], "maxDistEm": 4.0, "_": "대양 영문 이름"},
   {"role": "water", "font": "^YDVYMjOStd33$", "color": "#0072bc", "joinEm": 2.8, "_": "바다·만·해협·호수·하천: 파란 명조"},
   {"role": "landform", "font": "^NanumMyeongjo", "color": "#231f20", "joinEm": 4.0, "_": "산맥·사막·평원·고원·지역: 굵은 명조(곡선 글자)"},
   {"role": "land", "font": "^YDVYMjOStd3[23]$", "color": "#231f20", "joinEm": 2.2, "_": "섬·제도·반도·곶·만리장성: 검은 명조"},
   {"role": "city", "font": "^YDVYGOStd32$", "color": "#231f20", "size": [5.6, 5.8], "joinEm": 0.4, "point": true, "_": "도시(작은 글자)·산 이름: 고딕"},
   {"role": "city", "font": "^YDVYGOStd33$", "color": "#231f20", "size": [5.9, 7.3], "joinEm": 0.4, "point": true, "_": "큰 도시·수도: 굵은 고딕"}
  ],
  "exclude": [
   {"re": "^\\(|^[^(]*\\)$|,$", "why": "괄호 안 병기(다른 이름·소속국 표시: (인), (러), (파라셀 군도, …)와 그 토막)"},
   {"re": "^[:·.]$", "why": "기호 글자"}
  ],
  "kinds": {
   "country": [["", "country"]],
   "water": [["강$|강\\)$|천$|강\\(.*\\)$", "river"], ["", "sea"]],
   "landform": [["산맥$|산지$|산$", "mountain"], ["사막$", "desert"], ["평원$|평야$|저지$|초원$|분지$|고원$|삼각주$", "plain"], ["", "region"]],
   "land": [["반도$", "region"], ["곶$|장성$|기지$", "other"], ["", "island"]],
   "city": [["", "city"]]
  },
  "altMaxEm": 2.0,
  "_altMaxEm": "따로 놓인 괄호 병기((시짱 고원), (K2), (아모이))는 같은 역할이고 글자 상자 사이 거리가 altMaxEm·크기 안인 지명 중 중심이 가장 가까운 것의 alt(다른 이름)가 된다. (인)·(러) 같은 소속 표시는 뺀다.",
  "kindBySymbol": {"capital": "capital", "mountain": "mountain"},
  "_kinds": "kinds[role] = [[정규식, 종류], ...] 처음 맞는 것. 호수·해구·해협·만은 sea(물), 고원·분지는 plain(평탄 지형 묶음). city 역할은 짝지은 기호가 수도(붉은 사각·원)면 capital, 삼각형이면 mountain.",
  "symbols": {
   "sizeRange": [1.5, 6.6],
   "concentricPt": 0.9,
   "pairMaxEm": 2.4,
   "mismatchPenaltyEm": 2.5,
   "_pair": "점 지명 ↔ 기호는 (거리 + 어긋남 벌점) 작은 순 일대일. 어긋남 = 산 높이 숫자가 붙은 지명인데 기호가 삼각형이 아님(또는 그 반대). 거리 상한은 pairMaxEm·글자 크기.",
   "elevMaxEm": 2.0,
   "classes": [
    {"cls": "capital", "fill": ["#ef4030"], "_": "수도: 붉은 사각(큰 나라)·붉은 원"},
    {"cls": "mountain", "fill": ["#d71920", "#231f20"], "ops": "^l{3,4}$", "_": "산: 붉은·검은 삼각형"},
    {"cls": "city", "fill": ["#ffffff"], "_": "큰 도시: 흰 사각·흰 이중 원"},
    {"cls": "city", "fill": [null], "stroke": "#231f20", "ops": "^(c{4}|l{4}|r)$", "size": [1.6, 3.0], "_": "도시: 작은 원·사각 테두리"}
   ]
  },
  "chain": {"touchEm": 0.3, "touchPerpEm": 0.2, "singlePerpEm": 0.7, "touchSinglePerpEm": 0.8, "bendDeg": 15, "lineGapEm": 1.2, "nextLineEm": 0.5},
  "_chain": "묶기(places.py group) 수치. 같은 글자 줄 잇기: 두 방향 평균 축에 대한 수직 어긋남이 한 글자가 낀 연결이면 singlePerpEm(빈틈이 touchEm 안이면 touchSinglePerpEm)·크기 이하이거나 축과 bendDeg 안, 여러 글자끼리는 같은 기준선(touchPerpEm)에서 빈틈 touchEm 안일 때만. 여러 줄 지명 후보는 글자 상자 사이 lineGapEm·크기 안, 줄 바꿈 판정은 수직 nextLineEm·크기 초과.",
  "rankBySize": [[11.0, 1], [9.0, 2], [7.5, 3], [6.8, 4], [5.8, 5], [0, 6]],
  "rankAdjust": {"capital": -1},
  "regionalRankPenalty": 1,
  "_rank": "rank = 개관도(16쪽) 글자 크기 단계(가장 큰 것 1) + rankAdjust[kind]. 16쪽에 없고 18·19쪽에만 있으면 그쪽 글자 크기 단계 + regionalRankPenalty(지역도는 축척이 커 같은 지명도 글자가 커서 16쪽과 비교할 수 없음).",
  "dedupKm": {"point": 60, "pointNoSymbol": 150, "area": 20000},
  "decimals": 2,
  "neFile": "raw/ne/ne_10m_populated_places.geojson",
  "neBox": [20, -15, 180, 82],
  "_ne": "Natural Earth 10m 인구 지점($ATLAS_WORK/neFile, NAME_KO 로 짝짓기, neBox = [경도 최소, 위도 최소, 경도 최대, 위도 최대] 아시아 범위). build_places(바로잡기·대조)와 city_controls(기준점)가 함께 쓴다.",
  "kindList": ["country", "capital", "city", "mountain", "river", "sea", "region", "island", "desert", "plain", "other"],
  "cityKinds": ["city", "capital"],
  "mergeFamily": {"capital": "city"},
  "_mergeFamily": "합치기 묶음: 수도와 도시는 지도마다 기호가 다를 수 있어 한 묶음. cityKinds = Natural Earth 인구 지점과 견주는 종류.",
