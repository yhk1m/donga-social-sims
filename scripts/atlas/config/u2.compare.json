{
 "_doc": "교과서 대조표(compare_shots.mjs · compare.mjs --unit u2) 단원 설정. 단원 설정 u2.json 은 생성물 도장에 들어가 얼려 두었으므로 대조표 값은 이 파일에 따로 둔다(2단계 설계 §4.2). 경로는 작업 폴더 기준.",
 "shotsDir": "shots/e2",
 "out": "compare-u2.html",
 "_paths": "u2 는 1단계 자리(shots/e2 · compare-u2.html) 그대로 — G0 기준선과 같은 자리. 새 단원 기본값은 단원 작업 폴더의 shots/compare · compare.html.",
 "projections": {"default": "robinson", "extra": {"general": ["equalEarth"], "coloring": ["equalEarth"]}},
 "_projections": "장면 = 주제마다 기본 도법 + extra 도법(일반도·색칠하기 = 교과서 람베르트 정적 방위에 가까운 정적 도법 이퀄어스). 도법마다 묶음(지도 고르기)마다 한 장, 묶음이 없으면 주제 한 장 + 바로가기(views)마다 한 장.",
 "extraScenes": {
  "_doc": "주제 id → 덧붙임 장면 목록. open 이 없으면 기본 도법 장면을 찍은 그 쪽에서 이어서, open: {proj} 이면 그 주제 장면을 다 찍은 뒤 새로 연다. name 은 --only 고르기 이름(null = 늘 돈다). steps: eval(식 — {R} = 조각 래퍼) · idle · sleep(ms) · scrollTop · scrollTo{sel, index} · showGroup(번호 | {ref}) · fitView(바로가기 id) · hover{sel, index} · mouse[x, y] · take{name, info}. info 값 '@groupLabel'·'@groupIndex'·'@groupRefs' = 마지막 showGroup 의 묶음.",
  "general": [
   {"name": "general-tint-off", "steps": [
    {"eval": "{R}.atlasMap.setOptions({tint:false, natural:false})"}, {"idle": true}, {"sleep": 400}, {"scrollTop": true},
    {"take": "general-tint-off", "info": {"kind": "extra", "note": "바탕 색 없음(같은 보기)"}},
    {"eval": "{R}.atlasMap.setOptions({tint:true, natural:false})"}, {"idle": true}]},
   {"name": "general-goode-tint", "open": {"proj": "goode"}, "steps": [
    {"take": "general-goode-tint", "info": {"kind": "extra", "note": "고도 색 켬(goode)"}},
    {"eval": "{R}.atlasMap.setOptions({tint:false})"}, {"idle": true}, {"sleep": 400},
    {"take": "general-goode-tint-off", "info": {"kind": "extra", "note": "고도 색 끔(goode)"}}]},
   {"name": "general-miller-tint", "open": {"proj": "miller"}, "steps": [
    {"fitView": "east-asia"}, {"idle": true}, {"sleep": 400},
    {"take": "general-miller-tint", "info": {"kind": "extra", "note": "고도 색 켬(miller)"}},
    {"eval": "{R}.atlasMap.setOptions({tint:false})"}, {"idle": true}, {"sleep": 400},
    {"take": "general-miller-tint-off", "info": {"kind": "extra", "note": "고도 색 끔(miller)"}}]}
  ],
  "relief": [
   {"name": "relief-base-tint", "steps": [
    {"eval": "{R}.atlasMap.setOptions({tint:true, natural:false})"}, {"idle": true}, {"sleep": 400}, {"scrollTop": true},
    {"take": "relief-base-tint", "info": {"kind": "extra", "note": "고도 색(같은 보기)"}}]},
   {"name": "relief-base-none", "steps": [
    {"eval": "{R}.atlasMap.setOptions({tint:false, natural:false})"}, {"idle": true}, {"sleep": 400}, {"scrollTop": true},
    {"take": "relief-base-none", "info": {"kind": "extra", "note": "바탕 색 없음(같은 보기)"}}]},
   {"name": null, "steps": [{"eval": "{R}.atlasMap.setOptions({tint:false, natural:true})"}, {"idle": true}]},
   {"name": "relief-pins", "steps": [
    {"scrollTo": {"sel": ".at-reveal-btn"}}, {"take": "relief-pins-hidden", "info": {"kind": "extra", "note": "핀 번호 숨김(처음)"}},
    {"eval": "{R}.atlasTopic.pins.reveal({R}.atlasTopic.pins.markers[1].id)"}, {"sleep": 300},
    {"take": "relief-pins-one", "info": {"kind": "extra", "note": "핀 하나 번호 보임"}},
    {"eval": "{R}.querySelector('.at-reveal-btn').click()"}, {"sleep": 300},
    {"take": "relief-pins-all", "info": {"kind": "extra", "note": "번호 모두 보기"}},
    {"eval": "{R}.querySelector('.at-reveal-btn').click()"}, {"sleep": 200}]}
  ],
  "religion": [
   {"name": "religion-inset-hover", "steps": [
    {"showGroup": {"ref": "layer-p22-singapore"}}, {"idle": true}, {"sleep": 500},
    {"hover": {"sel": ".at-inset-sym", "index": 10}},
    {"take": "religion-inset-hover", "info": {"group": "@groupLabel", "groupIndex": "@groupIndex", "refs": "@groupRefs", "kind": "extra", "note": "싱가포르 확대 창 — 기호 말풍선"}},
    {"mouse": [5, 5]}]}
  ],
  "industry": [
   {"name": "industry-barpick", "steps": [
    {"showGroup": 0}, {"idle": true},
    {"scrollTo": {"sel": ".at-barpick"}}, {"sleep": 300},
    {"take": "industry-barpick", "info": {"kind": "extra", "chart": "p24-resources", "note": "100% 막대 하나씩 보기(자원)"}},
    {"scrollTo": {"sel": ".at-barpick", "index": 1}}, {"sleep": 300},
    {"take": "industry-barpick-2", "info": {"kind": "extra", "chart": "p24-exports", "note": "100% 막대 하나씩 보기(수출)"}},
    {"eval": "[...{R}.querySelectorAll('.at-barpick')][0].querySelector('.at-expand').click()"}, {"sleep": 700},
    {"take": "industry-barpick-expand", "info": {"kind": "extra", "chart": "p24-resources", "note": "크게 보기(자원 다섯 막대)"}},
    {"eval": "{R}.atlasUi.viewer.hide()"}]},
   {"name": "industry-miller-trade", "open": {"proj": "miller"}, "steps": [
    {"showGroup": {"ref": "layer-p24-trade"}}, {"idle": true}, {"sleep": 500}, {"scrollTop": true},
    {"take": "industry-miller-trade", "info": {"groupIndex": "@groupIndex", "refs": ["layer-p24-trade"], "kind": "group", "note": "교과서와 같은 밀러 태평양 중심"}}]}
  ],
  "population": [
   {"name": "population-charts", "steps": [
    {"scrollTo": {"sel": ".at-chart[data-chart=p23-world-pop]"}}, {"sleep": 400},
    {"take": "population-charts", "info": {"kind": "extra", "chart": "p23-world-pop", "note": "사이드바 그래프(세계 인구)"}}]}
  ],
  "climate": [
   {"name": "climate-charts", "steps": [
    {"scrollTo": {"sel": ".at-chart"}}, {"sleep": 400},
    {"take": "climate-charts", "info": {"kind": "extra", "note": "사이드바 기후 그래프"}}]}
  ],
  "heritage": [
   {"name": "heritage-quiz", "steps": [
    {"scrollTo": {"sel": ".at-quiz"}}, {"sleep": 800},
    {"take": "heritage-quiz", "info": {"kind": "extra", "note": "세계유산 퀴즈(첫 문제)"}},
    {"eval": "{R}.querySelector('.at-quiz-opt')?.click()"}, {"sleep": 500},
    {"take": "heritage-quiz-answer", "info": {"kind": "extra", "note": "세계유산 퀴즈(답한 뒤)"}}]}
  ],
  "coloring": [
   {"name": "coloring-quiz", "steps": [
    {"scrollTo": {"sel": ".at-quiz"}}, {"sleep": 400},
    {"take": "coloring-quiz", "info": {"kind": "extra", "note": "색칠하기 활동"}}]}
  ]
 },
 "checks": {
  "_doc": "compare.mjs 의 단원 고유 확인. coloringLabels = 색칠하기 지면 글자(작업 폴더, 없으면 content.labels), insetLayers = 기호를 확대 창에서 세는 레이어, noScreenSymbols = 화면 기호를 세지 않는 레이어(이미지 위 점 등), centerChecks = 도법·중심 확인 줄, mainMap = 묶음·바로가기가 없는 주제의 대표 지도.",
  "coloringLabels": "text/p17-labels.json",
  "insetLayers": ["layer-p22-singapore"],
  "noScreenSymbols": ["layer-p23-density-cities"],
  "centerChecks": [{"ref": "layer-p24-trade", "tb": "밀러, 태평양 중심", "web": "묶음을 고르면 중심 경도 150(태평양)"}],
  "mainMap": {"general": "p16-asia", "coloring": "p17-coloring", "relief": "p20-relief", "heritage": "p25-heritage"}
 },
 "notes": {
  "_doc": "대조표 「알려진 차이」·「참고」 줄의 단원 고유 설명(결정 기록 근거).",
  "recolored": "교사 요청(2026-10-20): 웹 바탕 위에서 너무 옅어 명도만 낮춤(설정 legendColors)",
  "noVecLegend": "경계는 실제 자료(Natural Earth), 종교 면·지명은 교과서 모식도에서 옮김 — 교과서 범례 7항목(주장 국경 3·정전 라인·종교 3)",
  "mapLabelToLegend": "C1 결정 — 관할 지역 면은 Natural Earth 분쟁 지역, 교과서의 지도 위 이름을 범례로",
  "movedPlaces": "교사 확인(2026-10-19): 「대한민국」·「미국」 본토 위로 좋음",
  "viewProjection": "로빈슨(기본) · 둘째 캡처 이퀄어스(정적 도법)",
  "viewProjectionNote": "웹은 세계 도법 5종만(람베르트 없음)"
 }
}
