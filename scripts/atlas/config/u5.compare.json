      "eval": "(async()=>{const el={R}.querySelector('.at-outline-shape');const r=el.getBoundingClientRect();let x=r.x+r.width/2,y=r.y+r.height/2;for(let fy=0.3;fy<0.9;fy+=0.1)for(let fx=0.3;fx<0.8;fx+=0.1){const px=r.x+r.width*fx,py=r.y+r.height*fy;if(document.elementFromPoint(px,py)===el){x=px;y=py;fy=fx=9;}}const ev=(t,i,b)=>el.dispatchEvent(new PointerEvent(t,{pointerId:1,pointerType:'mouse',isPrimary:true,button:0,buttons:b,clientX:x+240*i/12,clientY:y+-120*i/12,bubbles:true,cancelable:true}));ev('pointerdown',0,1);for(let i=1;i<=12;i++){ev('pointermove',i,1);await new Promise(r=>setTimeout(r,30));}ev('pointerup',12,0);})()"
